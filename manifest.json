{
  "manifest_version": 3,
  "name": "Add-in Session Inbox",
  "version": "1.0.0",
  "description": "Side panel showing which Claude add-in sessions in PowerPoint and Outlook for the web are working, need input or are done.",
  "permissions": ["sidePanel", "storage", "tabs", "notifications"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://pivot.claude.ai/*"],
      "js": ["src/selectors.js", "src/content/claude-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.sharepoint.com/:p:/*"],
      "js": ["src/selectors.js", "src/content/ppt-page.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Add-in Session Inbox",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
